{
  "name": "compound-calc-infra",
  "version": "1.0.0",
  "description": "AWS CDK infrastructure for CompoundCalc - Kafka-powered compound interest calculator",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "cdk": "cdk",
    "synth": "cdk synth",
    "deploy": "cdk deploy --all --require-approval never",
    "destroy": "cdk destroy --all --force"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.140.0",
    "constructs": "^10.3.0",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "aws-cdk": "^2.140.0",
    "typescript": "~5.4.5"
  }
}
